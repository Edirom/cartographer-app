# Android release signing — TEMPLATE (committed, safe to share).
#
# The real config lives at .signing/keystore.properties (gitignored) and is
# normally created for you by:  npm run android:keystore
#
# To set it up manually instead:
#   1. mkdir -p .signing
#   2. cp keystore.properties.example .signing/keystore.properties
#   3. put your keystore at .signing/release.keystore (or update storeFile below)
#   4. fill in the real passwords
#
# Never commit the real keystore.properties or any *.keystore / *.jks file.

# Absolute path is safest; a relative path is resolved from the app Gradle module.
storeFile=/absolute/path/to/.signing/release.keystore
keyAlias=upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
