# GitHub OAuth App credentials
# Create an OAuth App at https://github.com/settings/developers
#
# Register this exact Authorization callback URL in the OAuth App settings
# (the dev server serves under /myAppPlaceholder/):
#   http://localhost:8080/myAppPlaceholder/callback

# Public identifier — exposed to the browser bundle via DefinePlugin in vue.config.js
GH_APP_CLIENT_ID=

# Exposed to the browser bundle via DefinePlugin in vue.config.js
GH_APP_CALL_BACK=

# Server-side only: consumed by the dev proxy (and nginx in production) for the
# token exchange. Never referenced in client code, never bundled into the SPA.
GH_APP_CLIENT_SECRET=

